      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "+-------------+-------------+\n",
            "|      Borough|total_pickups|\n",
            "+-------------+-------------+\n",
            "|    Manhattan|      6950511|\n",
            "|       Queens|       471113|\n",
            "|      Unknown|       159807|\n",
            "|     Brooklyn|        91896|\n",
            "|        Bronx|        18056|\n",
            "|          N/A|         3890|\n",
            "|          EWR|          446|\n",
            "|Staten Island|          361|\n",
            "+-------------+-------------+\n",
            "\n"
          ]
        }
      ],
      "source": [
        "spark.sql('''\n",
        "    SELECT z.Borough, COUNT(*) AS total_pickups\n",
        "    FROM trips_2019 t\n",
        "    JOIN zones z ON t.PULocationID = z.LocationID\n",
        "    GROUP BY z.Borough\n",
        "    ORDER BY total_pickups DESC\n",
        "''').show()"
      ]
